# Master key used to encrypt secrets (passwords/PATs) stored in database_configurations.configuration
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit the real value. NEVER store it in data/app.db.
DB_VALIDATOR_MASTER_KEY=

# Path to the application SQLite database (metadata store, not schema data)
DB_VALIDATOR_APP_DB=data/app.db

# Root folder for file-based artifacts (schema JSON snapshots, HTML reports, uploads)
DB_VALIDATOR_DATA_DIR=data

# Logging level
DB_VALIDATOR_LOG_LEVEL=INFO
